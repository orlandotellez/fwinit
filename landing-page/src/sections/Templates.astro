---
import { ArrowRight } from 'lucide-astro';
import SectionHead from '../components/SectionHead.astro';
import TemplateCard from '../components/TemplateCard.astro';
import { countByLayer, templates } from '../data/templates';

const filters = [
  { id: 'all', label: 'Todas', count: countByLayer('all') },
  { id: 'backend', label: 'Backend', count: countByLayer('backend') },
  { id: 'frontend', label: 'Frontend', count: countByLayer('frontend') },
] as const;
---

<section class="section" id="plantillas" aria-labelledby="templates-title">
  <div class="container">
    <SectionHead
      eyebrow="8 plantillas"
      title="Cada capa con su stack, todas con la misma forma"
      lede="Backend con su base de datos, frontend con su design system. Elegí una o combiná dos en un full stack."
      id="templates-title"
    />

    <div class="templates__toolbar">
      <div class="chip-row" role="group" aria-label="Filtrar plantillas por capa">
        {
          filters.map((filter) => (
            <button
              type="button"
              class="chip"
              data-filter-layer={filter.id}
              aria-pressed={filter.id === 'all' ? 'true' : 'false'}
            >
              {filter.label}
              <span class="chip__count">{filter.count}</span>
            </button>
          ))
        }
      </div>
      <p class="result-count" role="status" aria-live="polite" data-tpl-count>
        {templates.length} plantillas
      </p>
    </div>

    <ul role="list" class="grid grid--3 templates__grid" data-tpl-grid data-reveal>
      {
        templates.map((template) => (
          <li data-tpl-item>
            <TemplateCard template={template} />
          </li>
        ))
      }
    </ul>

    <p class="templates__foot">
      <span class="caption">¿Necesitás otro stack?</span>
      <a class="head-row__link" href="#faq">
        Cómo se suma un template
        <ArrowRight size={16} stroke-width={1.75} aria-hidden="true" focusable="false" />
      </a>
    </p>
  </div>
</section>

<style>
  .templates__toolbar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: var(--space-2xs);
    margin-bottom: var(--space-md);
    padding-bottom: var(--space-sm);
    border-bottom: var(--hairline);
  }

  .templates__grid {
    align-items: stretch;
    /* Ocultar tarjetas al filtrar no debe provocar saltos de scroll. */
    content-visibility: auto;
  }

  .templates__grid > li {
    display: flex;
    min-width: 0;
  }

  .templates__grid > li > :global(*) {
    width: 100%;
  }

  .templates__grid > li[hidden] {
    display: none;
  }

  .templates__foot {
    display: flex;
    align-items: baseline;
    flex-wrap: wrap;
    gap: var(--space-2xs);
    margin-top: var(--space-md);
  }
</style>
