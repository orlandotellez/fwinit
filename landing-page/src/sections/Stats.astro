---
import { ArrowRight, ArrowUpRight } from 'lucide-astro';
import { facts, site } from '../data/site';

const cards = [
  {
    value: String(facts.templates),
    label: 'plantillas listas para usar',
    rows: [
      { key: 'Backend', value: `${facts.backends} · APIs REST` },
      { key: 'Frontend', value: `${facts.frontends} · apps y landings` },
      { key: 'Runtimes', value: 'Bun, Node.js, .NET, Flutter' },
      { key: 'ORMs', value: 'Prisma, Drizzle, EF Core' },
    ],
    chips: ['aspnet', 'express', 'fastify', 'nodejs', 'astro', 'tauri', 'react-native', 'flutter'],
    link: { href: '#plantillas', text: 'Ver las plantillas' },
  },
  {
    value: String(facts.agentDirs),
    label: 'carpetas de agentes en cada proyecto',
    rows: [
      { key: 'Skills', value: `${facts.skills} · specs, prompts y diseño` },
      { key: 'Estilos', value: `${facts.designStyles} curados + catálogo` },
      { key: 'Comandos', value: '/create-specs · /design-<estilo>' },
      { key: 'Global', value: `${facts.globalTargets} destinos` },
    ],
    chips: ['.opencode/', '.pi/', '.agents/'],
    link: { href: '#skills', text: 'Ver las skills' },
  },
] as const;
---

<section class="section section--alt stats" id="numeros" aria-labelledby="stats-title">
  <div class="container">
    <header class="section-head">
      <p class="eyebrow">En números</p>
      <h2 class="section-head__title" id="stats-title">Todo lo demás ya está resuelto</h2>
      <p class="section-head__lede">
        Lo que en un proyecto nuevo se decide a mano —capas, base de datos, skills del
        agente— acá ya viene elegido y documentado.
      </p>
    </header>

    <div class="grid grid--2 stats__grid">
      {
        cards.map((card) => (
          <article class="card stat" data-reveal>
            <div class="stat__head">
              <p class="stat__value tabular">{card.value}</p>
              <p class="stat__label">{card.label}</p>
            </div>

            <ul role="list" class="stat__rows">
              {card.rows.map((row) => (
                <li class="stat__row">
                  <span class="stat__row-key">{row.key}</span>
                  <span class="stat__row-value">{row.value}</span>
                </li>
              ))}
            </ul>

            <ul role="list" class="stat__chips">
              {card.chips.map((chip) => (
                <li class="tag">{chip}</li>
              ))}
            </ul>

            <a class="stat__link head-row__link" href={card.link.href}>
              {card.link.text}
              <ArrowRight size={16} stroke-width={1.75} aria-hidden="true" focusable="false" />
            </a>
          </article>
        ))
      }
    </div>

    <p class="stats__note caption">
      Números contados desde el repo en build, no estimados · <a
        href={`${site.repoUrl}/graphs/contributors`}
        target="_blank"
        rel="noopener noreferrer"
      >
        contribuciones en GitHub
        <ArrowUpRight size={14} stroke-width={1.75} aria-hidden="true" focusable="false" />
      </a>
    </p>
  </div>
</section>

<style>
  .stats__grid {
    align-items: stretch;
  }

  .stat {
    display: flex;
    flex-direction: column;
    gap: var(--space-sm);
    padding: var(--space-lg);
  }

  .stat__head {
    display: flex;
    flex-direction: column;
    gap: 2px;
  }

  .stat__value {
    color: var(--text);
    font-family: var(--font-mono);
    font-size: clamp(2.75rem, 4.6vw, 3.5rem);
    font-weight: 600;
    line-height: 1;
    letter-spacing: -0.03em;
  }

  .stat__label {
    color: var(--text-secondary);
    font-size: var(--text-small);
  }

  .stat__rows {
    display: flex;
    flex-direction: column;
    margin: 0;
    padding: 0;
    list-style: none;
    border-top: var(--hairline);
  }

  .stat__row {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: var(--space-xs);
    padding-block: 10px;
    border-bottom: var(--hairline);
    font-size: var(--text-caption);
  }

  .stat__row-key {
    color: var(--text-muted);
    text-transform: uppercase;
    letter-spacing: 0.07em;
    flex: none;
  }

  .stat__row-value {
    color: var(--text-secondary);
    font-family: var(--font-mono);
    text-align: right;
  }

  .stat__chips {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .stat__link {
    margin-top: auto;
    padding-top: var(--space-2xs);
    color: var(--accent);
  }

  .stats__note {
    margin-top: var(--space-md);
    text-align: center;
    color: var(--text-muted);
  }

  @media (max-width: 700px) {
    .stat {
      padding: var(--space-md);
    }

    .stat__row {
      flex-direction: column;
      gap: 2px;
    }

    .stat__row-value {
      text-align: left;
    }
  }
</style>
