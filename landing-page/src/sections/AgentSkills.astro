---
import { FolderTree, Sparkles } from 'lucide-astro';
import CodeBlock from '../components/CodeBlock.astro';
import SectionHead from '../components/SectionHead.astro';
import { agentDirs, agentSkills, catalog, designStyles, globalTargets } from '../data/skills';
---

<section class="section" id="skills" aria-labelledby="skills-title">
  <div class="container">
    <SectionHead
      eyebrow="Skills de agentes"
      title="El proyecto nace con contexto para tu agente"
      lede="Cada proyecto generado trae el bundle de skills de fwinit: tres skills de especificación y la biblioteca de diseño completa, en el layout que tu agente ya sabe leer."
      id="skills-title"
    />

    <ul role="list" class="grid grid--3 skills-grid" data-reveal>
      {
        agentSkills.map((skill) => (
          <li class="card skill">
            <div class="skill__head">
              <h3 class="skill__name mono">{skill.name}</h3>
              <span class="badge badge--category mono">{skill.command}</span>
            </div>
            <p class="card__text">{skill.summary}</p>
            <p class="skill__output">{skill.output}</p>
          </li>
        ))
      }
    </ul>

    <div class="skills__panels" data-reveal>
      <article class="card skills__panel" aria-labelledby="design-title">
        <div class="skills__panel-head">
          <span class="card__icon">
            <Sparkles size={20} stroke-width={1.75} aria-hidden="true" focusable="false" />
          </span>
          <div>
            <h3 id="design-title">Biblioteca de diseño</h3>
            <p class="caption">
              Seis estilos curados, un comando por estilo: <code>/design-&lt;estilo&gt;</code>
            </p>
          </div>
        </div>

        <ul role="list" class="styles">
          {
            designStyles.map((style) => (
              <li class="styles__item">
                <span class="pill pill--mono">{style.name}</span>
                <span class="styles__text">{style.summary}</span>
              </li>
            ))
          }
        </ul>

        <div class="catalog">
          <p class="catalog__title">
            <span class="mono">{catalog.name}</span>
            <span class="caption">catálogo search-driven, offline, con {catalog.command}</span>
          </p>
          <ul role="list" class="catalog__counts">
            {
              catalog.counts.map((item) => (
                <li>
                  <span class="catalog__value tabular">{item.value}</span>
                  <span class="catalog__label">{item.label}</span>
                </li>
              ))
            }
          </ul>
        </div>
      </article>

      <article class="card skills__panel" aria-labelledby="where-title">
        <div class="skills__panel-head">
          <span class="card__icon">
            <FolderTree size={20} stroke-width={1.75} aria-hidden="true" focusable="false" />
          </span>
          <div>
            <h3 id="where-title">Dónde vive el bundle</h3>
            <p class="caption">Mismo layout en los tres destinos del proyecto</p>
          </div>
        </div>

        <ul role="list" class="dirs">
          {
            agentDirs.map((dir) => (
              <li>
                <code>{dir.id}</code>
                <span>{dir.label}</span>
              </li>
            ))
          }
        </ul>

        <p class="caption skills__note">
          Los bundles se versionan con el repo: las skills y el design system viajan con el
          proyecto, para todo el equipo.
        </p>

        <CodeBlock label="instalar también global" code={`fwinit skills --global all`} />

        <ul role="list" class="targets">
          {
            globalTargets.map((target) => (
              <li>
                <span class="targets__name">{target.label}</span>
                <code class="targets__path">{target.path}</code>
              </li>
            ))
          }
        </ul>
      </article>
    </div>
  </div>
</section>

<style>
  .skills-grid {
    align-items: stretch;
  }

  .skill {
    display: flex;
    flex-direction: column;
    gap: var(--space-2xs);
  }

  .skill__head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: var(--space-2xs);
  }

  .skill__name {
    font-size: var(--text-h4);
    font-weight: 600;
  }

  .skill__output {
    margin-top: auto;
    padding-top: var(--space-2xs);
    border-top: var(--hairline);
    color: var(--text-muted);
    font-size: var(--text-caption);
    line-height: 1.5;
  }

  .skills__panels {
    display: grid;
    grid-template-columns: 1.05fr 0.95fr;
    gap: var(--space-sm);
    margin-top: var(--space-sm);
    align-items: start;
  }

  .skills__panel {
    display: flex;
    flex-direction: column;
    gap: var(--space-sm);
    padding: var(--space-md);
  }

  .skills__panel-head {
    display: flex;
    align-items: flex-start;
    gap: var(--space-xs);
  }

  .skills__panel-head :global(.card__icon) {
    margin-bottom: 0;
    flex: none;
  }

  .skills__panel-head h3 {
    font-size: var(--text-h4);
  }

  .styles {
    display: flex;
    flex-direction: column;
    gap: 0;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .styles__item {
    display: grid;
    grid-template-columns: 11rem minmax(0, 1fr);
    align-items: baseline;
    gap: var(--space-2xs);
    padding-block: 10px;
    border-top: var(--hairline);
  }

  .styles__text {
    color: var(--text-secondary);
    font-size: var(--text-small);
  }

  .catalog {
    padding: var(--space-xs);
    border: 1px solid var(--border);
    border-radius: var(--radius-sm);
    background: var(--surface);
  }

  .catalog__title {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: var(--space-2xs);
  }

  .catalog__title :global(.mono) {
    color: var(--accent);
    font-size: var(--text-small);
  }

  .catalog__counts {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: var(--space-2xs);
    margin: var(--space-2xs) 0 0;
    padding: 0;
    list-style: none;
  }

  .catalog__counts li {
    display: flex;
    flex-direction: column;
    gap: 0;
  }

  .catalog__value {
    font-family: var(--font-mono);
    font-size: var(--text-h4);
    font-weight: 600;
    color: var(--text);
  }

  .catalog__label {
    color: var(--text-muted);
    font-size: var(--text-caption);
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }

  .dirs,
  .targets {
    display: flex;
    flex-direction: column;
    gap: 0;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .dirs li,
  .targets li {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: var(--space-2xs);
    padding-block: 8px;
    border-top: var(--hairline);
    font-size: var(--text-small);
  }

  .dirs li :global(code) {
    background: none;
    padding: 0;
    color: var(--accent);
    font-size: var(--text-code);
  }

  .dirs li span,
  .targets__name {
    color: var(--text-secondary);
  }

  .targets__path {
    background: none;
    padding: 0;
    color: var(--text-muted);
    font-size: var(--text-caption);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .skills__note {
    color: var(--text-muted);
  }

  @media (max-width: 900px) {
    .skills__panels {
      grid-template-columns: minmax(0, 1fr);
    }

    .styles__item {
      grid-template-columns: minmax(0, 1fr);
      gap: 4px;
    }
  }
</style>
