{
  "name": "fwinit",
  "version": "1.3.5",
  "description": "CLI para crear proyectos desde templates",
  "type": "module",
  "bin": {
    "fwinit": "./dist/index.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup src/index.ts --format esm --dts",
    "dev": "tsup src/index.ts --format esm --watch",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "chmod +x dist/index.js"
  },
  "dependencies": {
    "adm-zip": "^0.5.16",
    "chalk": "^5.4.1",
    "commander": "^13.1.0",
    "inquirer": "^12.4.2",
    "ora": "^8.2.0"
  },
  "devDependencies": {
    "@types/adm-zip": "^0.5.7",
    "@types/node": "^22.13.10",
    "tsup": "^8.4.0",
    "typescript": "^5.8.2"
  },
  "keywords": [
    "cli",
    "templates",
    "scaffolding",
    "framework",
    "boilerplate"
  ],
  "author": "Orlando Téllez",
  "license": "MIT"
}
